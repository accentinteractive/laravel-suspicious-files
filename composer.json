{
    "name": "accentinteractive/laravel-suspicious-files",
    "description": "Get notified when suspicious PHP files appear in your file system",
    "keywords": [
        "accentinteractive",
        "laravel-suspicious-files"
    ],
    "homepage": "https://github.com/accentinteractive/laravel-suspicious-files",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Joost van Veen",
            "email": "joost@accentinteractive.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "4.*|5.*|6.*|^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Accentinteractive\\LaravelSuspiciousFiles\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Accentinteractive\\LaravelSuspiciousFiles\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Accentinteractive\\LaravelSuspiciousFiles\\LaravelSuspiciousFilesServiceProvider"
            ]
        }
    }
}
